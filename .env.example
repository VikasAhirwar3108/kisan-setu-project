# Flask session security: generate a long random value and keep it private
SECRET_KEY=replace_with_a_long_random_secret

# Existing Neon/PostgreSQL connection string (keep your current value)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Firebase Web App configuration (Firebase Console > Project settings > Your apps)
# These web config values are public client configuration, not private admin credentials.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_web_app_id

# PRIVATE: paste the full Firebase service-account JSON as a single-line JSON value.
# Never commit the real value to GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Keep your existing Razorpay settings if payments are enabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
